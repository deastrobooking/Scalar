# Scalar defaults — ESP32-S3 with octal PSRAM (e.g. ESP32-S3-WROOM-1-N8R8)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# CPU at full speed; FPU-heavy DSP
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# C++20 for the shared DSP core
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n

# PSRAM: wavetable, terrain, and granular assets use external heap allocations
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536

# FreeRTOS: 1 kHz tick for responsive control task
CONFIG_FREERTOS_HZ=1000

# TinyUSB (USB MIDI device)
CONFIG_TINYUSB_MIDI_COUNT=1
